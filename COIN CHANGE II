class Solution {
    public int change(int amount, int[] coins) {
       // int INF = amount + 1;
        int [] dp = new int[amount+1];
        for(int x =1; x<=amount; x++){
            dp[x] = 0;
        }
        dp[0] = 1;

        for(int i = 0; i< coins.length; i++){
            int c = coins[i];

            for(int x = c; x<=amount; x++){
                
                    dp[x] += dp[x-c];
                
            }
        }
        return dp[amount];
    }
}
